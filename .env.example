# Database Configuration
DATABASE_URL=postgresql://supplychain:supplychain@localhost:5432/supply_chain_db
TEST_DATABASE_URL=postgresql://supplychain:supplychain@localhost:5432/supply_chain_test_db

# Database Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_QUERY_TIMEOUT=30
DB_ECHO_SQL=false

# External API Keys
NEWSAPI_KEY=your_newsapi_key_here
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=true

# Application Settings
LOG_LEVEL=INFO
